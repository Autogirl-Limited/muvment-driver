# Backend REST base URL (same backend as the Expo driver app)
NEXT_PUBLIC_API_URL=https://api-muvment.up.railway.app/api/v1
# STOMP/SockJS endpoint for live notifications
NEXT_PUBLIC_WS_URL=https://api-muvment.up.railway.app/ws
# Optional: Google Routes API key for traffic-aware routes on the navigation map
NEXT_PUBLIC_GOOGLE_ROUTES_API_KEY=
# Dev only: skip S3 uploads and send a placeholder image URL instead
NEXT_PUBLIC_USE_PLACEHOLDER_UPLOAD=false
NEXT_PUBLIC_DEFAULT_IMAGE_URL=
# Dev only: allow the app to render on desktop browsers (it is phone-only by default)
NEXT_PUBLIC_ALLOW_DESKTOP=false
# NextAuth (Auth.js v5) session signing secret: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_TRUST_HOST=true

# To exercise the UI without a backend, point the API at the built-in mock (dev only):
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/mock
